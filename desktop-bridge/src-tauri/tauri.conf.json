{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "GBA-Bridge-Sync",
  "version": "1.0.7",
  "identifier": "com.endrisusanto.gbabridge",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GBA Project Manager - Bridge Sync",
        "width": 640,
        "height": 720,
        "resizable": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFGODVFNzExRjdBODE2NjYKUldSbUZxajNFZWVGSHhWckorZGRNWkIzQUluN2htRnQ2SmRRb2pjS25qaHNxNUthcVlEcHE0QmQK",
      "endpoints": [
        "https://raw.githubusercontent.com/endrisusanto/project_manager/master/desktop-bridge/updater/latest.json",
        "https://gba.endrisusanto.my.id/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    }
  }
}
